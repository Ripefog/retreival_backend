# Milvus Configuration (new Zilliz Cloud database)
# Never commit real credentials. Set these in your deployment secret store.
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_ALIAS=default
MILVUS_USER=
MILVUS_PASSWORD=

# OpenSearch Configuration
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your_password
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# Collection names
METACLIP2_COLLECTION=arch_metaclip2_image_v100
BEIT3_COLLECTION=arch_beit3_image_v100
OBJECT_COLLECTION=arch_metaclip2_object_name_v100
COLOR_COLLECTION=arch_color_name_v100

# OpenSearch Index Names
METADATA_INDEX=video_retrieval_metadata_v3
OCR_INDEX=video_ocr
ASR_INDEX=video_asr

# Model Configuration
DEVICE=cuda  # or cpu

# Model Paths (optional - defaults will be used if not set)
METACLIP2_MODEL_NAME=facebook/metaclip-2-worldwide-huge-quickgelu
METACLIP2_DIM=1024
HF_CACHE_DIR=/app/models/huggingface
BEIT3_MODEL_PATH=models/beit3_base_patch16_384_coco_retrieval.pth
BEIT3_SPM_PATH=models/beit3.spm
CO_DETR_CONFIG_PATH=Co_DETR/projects/configs/co_dino/co_dino_5scale_swin_large_16e_o365tococo.py
CO_DETR_CHECKPOINT_PATH=models/co_dino_5scale_swin_large_16e_o365tococo.pth

# Search Configuration
DEFAULT_TOP_K=100
MAX_TOP_K=1000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Development Configuration
DEBUG=false
ENVIRONMENT=development 

# Gemini API for multi-query search
GOOGLE_API_KEY=
